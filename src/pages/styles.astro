---
import Layout from "../layouts/Layout.astro";
import HeadingSection from "../components/HeadingSection.astro";

const headingTreatments = [
  "none",
  "line",
  "glow",
  "inverted",
  "bordered",
] as const;
const headingAligns = ["left", "center"] as const;
const headingSizes = ["sm", "md", "lg"] as const;
const headingCombos = [
  ["line", "inverted"],
  ["line", "bordered"],
  ["line", "glow"],
  ["glow", "inverted"],
  ["line", "glow", "inverted"],
] as const;

type HeadingLineModifier = {
  label: string;
  treatment: "line" | ("line" | "inverted" | "bordered")[];
  lineColor?: "emphasis";
  lineFlush?: boolean;
};

const headingLineModifiers: HeadingLineModifier[] = [
  {
    label: 'lineColor: "emphasis"',
    treatment: "line",
    lineColor: "emphasis",
  },
  {
    label: "lineFlush: true",
    treatment: "line",
    lineFlush: true,
  },
  {
    label: "treatment: [line, inverted] · lineFlush: true",
    treatment: ["line", "inverted"],
    lineFlush: true,
  },
  {
    label: "treatment: [line, bordered] · lineFlush: true",
    treatment: ["line", "bordered"],
    lineFlush: true,
  },
  {
    label:
      'treatment: [line, bordered] · lineColor: "emphasis" · lineFlush: true',
    treatment: ["line", "bordered"],
    lineColor: "emphasis",
    lineFlush: true,
  },
  {
    label:
      'treatment: [line, inverted] · lineColor: "emphasis" · lineFlush: true',
    treatment: ["line", "inverted"],
    lineColor: "emphasis",
    lineFlush: true,
  },
];

// Pulled directly from src/styles/theme.css. Keep in sync when adding tokens.
const colorTokens = [
  {
    group: "structural",
    tokens: ["background", "background-dark", "foundation"],
  },
  {
    group: "emphasis",
    tokens: ["emphasis", "emphasis-hover", "faint", "fainter"],
  },
  {
    group: "accent",
    tokens: ["accent", "accent-hover", "accent-subtle"],
  },
  { group: "highlight", tokens: ["highlight", "highlight-hover"] },
  { group: "extra", tokens: ["undertone"] },
  {
    group: "materials",
    tokens: ["medal-gold", "medal-silver", "medal-bronze"],
  },
];

const colorGroupNotes: Record<string, string> = {
  structural:
    "The screen itself. Background is the page, background-dark is functionally black, foundation is baseline reading copy.",
  emphasis:
    "A gentle lift above foundation for subheads and labels. Faint and fainter are trace lines only: borders, rules, dot patterns. Never text.",
  accent:
    "The phosphor responding to input. Buttons, active states, bullets. Accent-subtle is the muted version for tonal shadows.",
  highlight:
    "Fuchsia breaks the phosphor. Maximum alert, reserved for the most important interactive element on a surface. Use once or twice per page.",
  extra: "Atmospheric depth in the Hero (gradient stops, glow). Not for UI.",
  materials:
    "Award medal glows. Alpha is baked into the token, so each metal's intensity is part of the decision.",
};

const patterns = [
  {
    name: ".hazard-stripe",
    note: "45° emphasis stripes. Operational warning marks.",
    class: "hazard-stripe",
  },
  {
    name: ".hazard-stripe--reverse",
    note: "135° variant for mirrored pairs.",
    class: "hazard-stripe--reverse",
  },
  {
    name: ".hazard-stripe__faint",
    note: "Stripes in the faint trace color. Recedes behind content.",
    class: "hazard-stripe__faint",
  },
  {
    name: ".pattern-dots",
    note: "0.25rem dot grid in fainter. The CRT's pixel structure.",
    class: "pattern-dots",
  },
  {
    name: ".pattern-dots__wide",
    note: "0.5rem dot grid for larger fills.",
    class: "pattern-dots pattern-dots__wide",
  },
];

const totalColorTokens = colorTokens.reduce(
  (sum, g) => sum + g.tokens.length,
  0,
);

const fontTokens = [
  {
    name: "display",
    label: "Prompt",
    role: "Display",
    note: "Entry titles, utility headings, subheads. Weights 300 to 900.",
  },
  {
    name: "decorative",
    label: "Manufacturing Consent",
    role: "Decorative",
    note: "The analyst's voice: section titles, hero headline, display stats. Swaps to Prompt (one size rung down) in simple mode.",
  },
  {
    name: "body",
    label: "Prompt",
    role: "Body",
    note: "Report body copy. Neutral, comfortable, serves both voices.",
  },
  {
    name: "mono",
    label: "IBM Plex Mono",
    role: "Monospace",
    note: "The terminal's voice: case numbers, marginalia, film labels, tech stacks. Small, uppercase, letter-spaced. Never headings.",
  },
];

// Mirrors the `@source inline("text-{...}")` list in theme.css. `custom: true`
// marks sizes that exist only because of local --text-* overrides; everything
// else is Tailwind v4's built-in scale.
const textSizes = [
  { name: "2xs", custom: true },
  { name: "xs" },
  { name: "sm" },
  { name: "base" },
  { name: "lg" },
  { name: "xl" },
  { name: "2xl" },
  { name: "3xl" },
  { name: "4xl" },
  { name: "5xl" },
  { name: "6xl" },
  { name: "7xl" },
  { name: "8xl" },
  { name: "9xl" },
];

const toSentenceCase = (text: string): string => {
  if (!text) return "";
  return text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
};
---

<Layout title="Styles & Design System — Grant Keller's Portfolio">
  <main
    class="bg-background-dark text-foundation min-h-screen overflow-hidden px-6
      pt-4 pb-32 md:px-12 lg:px-20"
  >
    <header
      class="border-fainter mx-auto mb-24 flex max-w-6xl items-end border-b
        pb-12"
    >
      <div class="mr-auto flex flex-col items-start">
        <h1
          class="font-display text-emphasis order-2 mb-8 text-4xl font-black
            tracking-wider md:text-5xl lg:text-6xl xl:text-7xl"
        >
          Styles & <span class="inline-block">Design System</span>
        </h1>

        <div class="order-3 max-w-prose">
          <p class="mb-4">
            The site is a classified dossier viewed on a near-future CRT
            terminal. Every token on this page is a property of that terminal or
            a mark left by the analyst reading the file.
          </p>
          <p>
            Two voices share every surface: the terminal (thin trace lines,
            monospace readouts, low contrast) and the analyst (ornamental
            headings, stamps, handwritten notes). Keep them distinct. Values are
            read live from <code class="font-mono">theme.css</code>; the full
            brief lives in <code class="font-mono">docs/DESIGN.md</code>.
          </p>
        </div>
        <a
          href="/"
          class="text-accent border-accent hover:bg-accent text-2xs order-1
            mb-24 border-b px-4 py-2 font-mono tracking-widest uppercase
            transition-colors hover:text-black"
        >
          &larr; Return to Site
        </a>
      </div>
    </header>

    <div class="mx-auto max-w-6xl">
      <!-- COLORS -->
      <section
        aria-labelledby="colors-heading"
        class="border-fainter mb-32 border-b pb-16"
      >
        <div class="text-emphasis mb-8 flex items-end gap-8">
          <h2
            id="colors-heading"
            class="font-display text-4xl leading-[0.7em] md:text-5xl"
          >
            Color
          </h2>
          <span
            class="text-background-dark bg-emphasis px-2 py-1 font-mono text-xs
              tracking-widest"
          >
            {totalColorTokens} tokens
          </span>
        </div>
        <div class="mb-8 max-w-prose">
          <p class="mb-4">
            Emerald is the phosphor, not a brand color. Tokens are named by role
            along one axis, attention intensity: foundation, emphasis, accent,
            highlight. Tokens without a hover variant are not interactive.
          </p>
          <p>
            The palette is subtractive. Start in the phosphor tint and add color
            only where removing it would lose information or interactivity.
            Never write raw hex or Tailwind palette classes; reference these
            tokens.
          </p>
        </div>
        <div
          class="border-fainter mb-24 flex h-12 w-full overflow-hidden border
            md:h-24"
          aria-hidden="true"
        >
          {
            [
              "background",
              "foundation",
              "emphasis",
              "faint",
              "accent",
              "highlight",
            ].map((name) => (
              <div
                class="flex-1"
                style={`background-color: var(--color-${name});`}
              />
            ))
          }
        </div>

        {
          colorTokens.map((g) => (
            <div class="mb-12">
              <h3 class="text-emphasis mb-2 font-mono text-base">
                {toSentenceCase(g.group)}
              </h3>
              <p class="mb-4 max-w-prose text-sm">{colorGroupNotes[g.group]}</p>
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {g.tokens.map((name) => (
                  <div class="group relative flex flex-col items-stretch">
                    <div
                      class="h-32 w-full shrink-0 border"
                      style={`background-color: var(--color-${name});`}
                    />
                    <div class="flex flex-col justify-center py-3">
                      <var
                        class="text-foundation mb-2 font-mono text-base
                          leading-tight"
                      >
                        --color-{name}
                      </var>
                      <code
                        class="text-foundation font-mono text-sm leading-tight"
                        data-color-value={name}
                      >
                        …
                      </code>
                      <code
                        class="text-foundation mt-1 font-mono text-xs
                          leading-tight"
                        data-color-hex={name}
                      >
                        …
                      </code>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <!-- FONTS -->
      <section
        aria-labelledby="fonts-heading"
        class="border-fainter mb-32 border-b pb-16"
      >
        <div class="mb-8 flex items-end gap-8">
          <h2
            id="fonts-heading"
            class="font-display text-emphasis text-4xl leading-[0.7em]
              md:text-5xl"
          >
            Typography
          </h2>
          <span
            class="bg-emphasis text-background-dark px-2 py-1 font-mono text-xs"
          >
            {fontTokens.length} families
          </span>
        </div>
        <div class="mb-8 max-w-prose">
          <p>
            Each family is a voice in the dossier. Display and body tokens
            compile straight to their primitives; decorative is swappable so
            simple mode can override it from the root.
          </p>
        </div>
        <div class="mb-24 lg:flex lg:gap-12">
          <p class="mb-2">
            Sample sentence is size <code class="bg-accent/20 ml-1 px-2"
              >text-5xl md:text-6xl</code
            >
          </p>
          <p>
            Sample glyphs are size <code class="bg-accent/20 ml-1 px-2"
              >text-4xl</code
            >
          </p>
        </div>

        <div>
          {
            fontTokens.map((font, index) => (
              <div
                class:list={[
                  "mb-24",
                  index !== fontTokens.length - 1 &&
                    "border-fainter/20 border-b pb-24",
                ]}
              >
                <div
                  class="mb-8 flex flex-col items-baseline gap-2 sm:flex-row
                    sm:gap-12 md:gap-16"
                >
                  <p
                    class="text-emphasis flex items-baseline font-mono
                      text-base"
                  >
                    <span class="text-accent">Role:&nbsp;</span>
                    {font.role}
                  </p>
                  <p
                    class="text-emphasis flex items-baseline font-mono
                      text-base"
                  >
                    <span class="text-accent">Typeface:&nbsp;</span>
                    {font.label}
                  </p>
                  <p
                    class="text-emphasis flex items-baseline font-mono
                      text-base"
                  >
                    <span class="text-accent">Token:&nbsp;</span>
                    <span class="font-mono">--font-{font.name}</span>
                  </p>
                </div>
                <p class="mb-8 max-w-prose">{font.note}</p>
                <p
                  class="text-foundation mb-16 text-2xl sm:text-4xl md:text-6xl"
                  style={`font-family: var(--font-${font.name});`}
                >
                  The sky above the port was the color of television, tuned to a
                  dead channel.
                </p>
                <p
                  class="text-emphasis tracking-huge text-4xl leading-[0.9em]
                    break-all"
                  style={`font-family: var(--font-${font.name});`}
                >
                  <span class="mb-4 block">ABCDEFGHIJKLMNOPQRSTUVWXYZ</span>
                  <span class="mb-4 block">abcdefghijklmnopqrstuvwxyz</span>
                  <span class="block">
                    0123456789 <span class="triplecolon">:::</span> ᠅
                  </span>
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- TYPE SCALE -->
      <section
        aria-labelledby="scale-heading"
        class="border-fainter mb-32 border-b pb-32"
      >
        <div class="mb-8 flex items-end gap-8">
          <h2
            id="scale-heading"
            class="font-display text-emphasis text-4xl leading-[0.7em]
              md:text-5xl"
          >
            Type Scale
          </h2>
          <span
            class="bg-emphasis text-background-dark px-2 py-1 font-mono text-xs
              tracking-widest"
          >
            {textSizes.length} sizes
          </span>
        </div>
        <div class="mb-24 max-w-prose">
          <p>
            Tailwind's default scale plus one custom rung, text-2xs, for film
            rebate labels and marginalia. Use the scale for hierarchy instead of
            fading text: muted copy is foundation at a smaller size, never a
            faint token.
          </p>
        </div>

        <div>
          {
            textSizes.map((t, index) => (
              <div
                class:list={[
                  "grid grid-cols-[2fr_3fr] items-center gap-8",
                  index !== textSizes.length - 1 &&
                    "border-fainter/20 mb-2 border-b pb-2",
                ]}
              >
                <div class="grid shrink grid-cols-[1fr_1fr] gap-4">
                  <p
                    class="text-foundation grid grid-cols-2 items-baseline gap-4
                      font-mono text-base"
                  >
                    <span class="block">text-{t.name}</span>
                    {t.custom && (
                      <span
                        class="text-accent font-mono text-xs tracking-widest"
                      >
                        Custom
                      </span>
                    )}
                  </p>
                  <p
                    class="text-emphasis block font-mono text-sm"
                    data-text-value={t.name}
                  >
                    …
                  </p>
                </div>
                <p
                  class="text-foundation font-display grow leading-[0.8em]"
                  style={`font-size: var(--text-${t.name});`}
                >
                  Aa
                </p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- SECTION HEADINGS -->
      <section aria-labelledby="headings-heading">
        <div class="mb-8 flex items-end gap-8">
          <h2
            id="headings-heading"
            class="font-display text-emphasis text-4xl leading-[0.7em]
              md:text-5xl"
          >
            Section Headings
          </h2>
          <span
            class="bg-emphasis text-background-dark px-2 py-1 font-mono text-xs
              tracking-widest"
          >
            {headingTreatments.length} treatments · {headingAligns.length} alignments
            · {headingSizes.length} sizes
          </span>
        </div>
        <div class="mb-24 max-w-prose">
          <p>
            <code class="font-mono">HeadingSection</code> renders the briefing's section
            inscriptions. Treatments compose as an array, so a heading can be lined,
            glowing, and inverted at once. Glow is dropped in simple mode.
          </p>
        </div>

        <!-- Treatments × alignments at size: md -->
        <div class="border-fainter/25 mb-48 border-b">
          <h3 class="text-emphasis mb-12 font-mono text-2xl font-light">
            Treatments × Alignments (size: md)
          </h3>
          <div>
            {
              headingTreatments.map((treatment) => (
                <div class="mb-32">
                  <div class="border-fainter/30 mb-8 flex flex-col border-b">
                    <h4
                      class="text-foundation border-fainter/30 mr-auto border
                        border-b-0 py-2 pl-1 font-mono text-base font-bold"
                    >
                      <>
                        <span
                          class="text-emphasis bg-background-dark py-1 pl-2
                            uppercase"
                        >
                          Treatment:&nbsp;
                        </span>
                        <span
                          class="text-foundation bg-background-dark py-1 pr-4"
                        >
                          {toSentenceCase(treatment)}
                        </span>
                      </>
                    </h4>
                  </div>
                  <div>
                    {headingAligns.map((align) => (
                      <div class="mb-32 flex flex-col overflow-hidden">
                        <h5
                          class="text-foundation relative mr-auto mb-8 block
                            font-mono text-sm whitespace-nowrap"
                        >
                          <span class="triplecolon text-accent">:::</span>
                          <span class="text-emphasis mr-auto">
                            Align:&nbsp;
                          </span>
                          {toSentenceCase(align)}
                          <span
                            class="pattern-dots absolute top-1/2 left-full ml-4
                              block h-1 w-dvw -translate-y-1/2 opacity-30"
                          />
                        </h5>
                        <HeadingSection
                          text="Section Heading"
                          as="p"
                          align={align}
                          size="md"
                          treatment={treatment}
                        />
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Sizes at treatment: none, align: center -->
        <div class="border-fainter/25 mb-48 border-b">
          <h3 class="text-emphasis mb-12 font-mono text-2xl font-light">
            Sizes (treatment: none, align: center)
          </h3>
          <div>
            {
              headingSizes.map((size) => (
                <div class="mb-32">
                  <div class="border-fainter/30 mb-8 flex flex-col border-b">
                    <h4
                      class="text-foundation border-fainter/30 mr-auto border
                        border-b-0 py-2 pl-1 font-mono text-base font-bold"
                    >
                      <>
                        <span class="text-emphasis bg-background-dark py-1 pl-2">
                          Size:&nbsp;
                        </span>
                        <span
                          class="text-foundation bg-background-dark py-1 pr-4"
                        >
                          {size}
                        </span>
                      </>
                    </h4>
                  </div>
                  <HeadingSection
                    text="Section Heading"
                    as="p"
                    size={size}
                    treatment="none"
                    align="center"
                  />
                </div>
              ))
            }
          </div>
        </div>

        <!-- Composed treatments at size: md, both alignments -->
        <div class="border-fainter/25 mb-48 border-b">
          <h3 class="text-emphasis mb-12 font-mono text-2xl font-light">
            Composed Treatments (size: md)
          </h3>
          <div>
            {
              headingCombos.map((combo) => (
                <div class="mb-32">
                  <div class="border-fainter/30 mb-8 flex flex-col border-b">
                    <h4
                      class="text-foundation border-fainter/30 mr-auto border
                        border-b-0 py-2 pl-1 font-mono text-base font-bold"
                    >
                      <>
                        <span
                          class="text-emphasis bg-background-dark py-1 pl-2
                            uppercase"
                        >
                          Treatment:&nbsp;
                        </span>
                        <span
                          class="text-foundation bg-background-dark py-1 pr-4"
                        >
                          [{combo.join(", ")}]
                        </span>
                      </>
                    </h4>
                  </div>
                  <div>
                    {headingAligns.map((align) => (
                      <div class="mb-32 flex flex-col overflow-hidden">
                        <h5
                          class="text-foundation relative mr-auto mb-8 block
                            font-mono text-sm whitespace-nowrap"
                        >
                          <span class="triplecolon text-accent">:::</span>
                          <span class="text-emphasis mr-auto">
                            Align:&nbsp;
                          </span>
                          {toSentenceCase(align)}
                          <span
                            class="pattern-dots absolute top-1/2 left-full ml-4
                              block h-1 w-dvw -translate-y-1/2 opacity-30"
                          />
                        </h5>
                        <HeadingSection
                          text="Section Heading"
                          as="p"
                          align={align}
                          size="md"
                          treatment={[...combo]}
                        />
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Line treatment modifiers -->
        <div class="border-fainter/25 mb-48 border-b">
          <h3 class="text-emphasis mb-12 font-mono text-2xl font-light">
            Line Modifiers (size: md, align: center)
          </h3>
          <div>
            {
              headingLineModifiers.map((mod) => (
                <div class="mb-32">
                  <div class="border-fainter/30 mb-8 flex flex-col border-b">
                    <h4
                      class="text-foundation border-fainter/30 mr-auto border
                        border-b-0 py-2 pl-1 font-mono text-base font-bold"
                    >
                      <>
                        <span class="text-emphasis bg-background-dark py-1 pl-2">
                          Config:&nbsp;
                        </span>
                        <span
                          class="text-foundation bg-background-dark py-1 pr-4"
                        >
                          {mod.label}
                        </span>
                      </>
                    </h4>
                  </div>
                  <HeadingSection
                    text="Section Heading"
                    as="p"
                    size="md"
                    treatment={mod.treatment}
                    lineColor={mod.lineColor}
                    lineFlush={mod.lineFlush}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <!-- PATTERNS -->
      <section
        aria-labelledby="patterns-heading"
        class="border-fainter mb-32 border-b pb-16"
      >
        <div class="mb-8 flex items-end gap-8">
          <h2
            id="patterns-heading"
            class="font-display text-emphasis text-4xl leading-[0.7em]
              md:text-5xl"
          >
            Patterns & Marks
          </h2>
          <span
            class="bg-emphasis text-background-dark px-2 py-1 font-mono text-xs
              tracking-widest"
          >
            {patterns.length + 2} utilities
          </span>
        </div>
        <div class="mb-16 max-w-prose">
          <p>
            Global utilities from <code class="font-mono">base.css</code>. Each
            must file, label, contain, authenticate, or annotate. If a real
            asset exists (film grain, ink stroke, stamp), use it instead of
            simulating it in CSS.
          </p>
        </div>
        <div class="mb-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            patterns.map((p) => (
              <div>
                <div
                  class:list={["border-fainter mb-3 h-24 border", p.class]}
                />
                <var class="text-foundation mb-1 block font-mono text-base">
                  {p.name}
                </var>
                <p class="text-sm">{p.note}</p>
              </div>
            ))
          }
        </div>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2">
          <div>
            <p class="text-emphasis mb-4 font-mono text-4xl">
              <span class="triplecolon text-accent">:::</span> Case 01.01
            </p>
            <var class="text-foundation mb-1 block font-mono text-base">
              .triplecolon
            </var>
            <p class="text-sm">
              Tightened ::: used as a filing-system decorator before labels.
            </p>
          </div>
          <div>
            <ul class="list-custom mb-4">
              <li class="mb-2">Field assignment</li>
              <li>Evidence photo</li>
            </ul>
            <var class="text-foundation mb-1 block font-mono text-base">
              .list-custom / .list-custom-wrapper
            </var>
            <p class="text-sm">
              ▹ bullets in accent. Wrapper form targets MDX-rendered lists.
            </p>
          </div>
        </div>
      </section>

      <!-- MODES -->
      <section aria-labelledby="modes-heading">
        <div class="mb-8 flex items-end gap-8">
          <h2
            id="modes-heading"
            class="font-display text-emphasis text-4xl leading-[0.7em]
              md:text-5xl"
          >
            Modes & Access
          </h2>
        </div>
        <dl class="grid max-w-prose grid-cols-1 gap-8">
          <div>
            <dt
              class="text-accent mb-2 font-mono text-sm tracking-widest
                uppercase"
            >
              Simple mode
            </dt>
            <dd>
              <code class="font-mono">html[data-simple-mode="on"]</code> swaps the
              decorative face for Prompt one size rung down, and removes noise, scanlines,
              and heading glow. For recruiters who need to scan, not explore.
            </dd>
          </div>
          <div>
            <dt
              class="text-accent mb-2 font-mono text-sm tracking-widest
                uppercase"
            >
              Focus
            </dt>
            <dd>
              2px accent-hover outline, square corners. 3px under
              prefers-contrast: high.
            </dd>
          </div>
          <div>
            <dt
              class="text-accent mb-2 font-mono text-sm tracking-widest
                uppercase"
            >
              Motion
            </dt>
            <dd>
              Under prefers-reduced-motion, transitions and keyframes collapse
              to 0.01ms and GSAP reveals are skipped, so every target renders in
              its final state.
            </dd>
          </div>
          <div>
            <dt
              class="text-accent mb-2 font-mono text-sm tracking-widest
                uppercase"
            >
              Breakpoints
            </dt>
            <dd>
              Tailwind defaults plus <code class="font-mono">xs</code> (420px) and
              a <code class="font-mono">portrait:</code> variant for aspect ratios
              under 1:1.
            </dd>
          </div>
        </dl>
      </section>
    </div>
  </main>

  <script>
    // Resolve computed values for each token so cards show the actual defined value.
    const rootStyle = getComputedStyle(document.documentElement);
    const rootFontPx = parseFloat(rootStyle.fontSize) || 16;
    const resolve = (prefix: string, token: string) =>
      rootStyle.getPropertyValue(`${prefix}${token}`).trim() || "(unset)";

    // Convert a CSS length string (rem/em/px) to a px value when possible.
    const toPx = (value: string) => {
      const match = value.match(/^(-?\d*\.?\d+)(rem|em|px)$/);
      if (!match) return null;
      const n = parseFloat(match[1]);
      const unit = match[2];
      if (unit === "px") return n;
      if (unit === "rem" || unit === "em") return n * rootFontPx;
      return null;
    };

    // Use a 1x1 canvas to convert any CSS color (oklch, color(), etc.) to sRGB
    // hex. Painting forces gamut mapping, so the hex matches what the browser
    // actually renders on this display.
    const probeCanvas = document.createElement("canvas");
    probeCanvas.width = 1;
    probeCanvas.height = 1;
    const probeCtx = probeCanvas.getContext("2d", { willReadFrequently: true });
    const toHex = (cssColor: string) => {
      if (!probeCtx || !cssColor || cssColor === "(unset)") return "";
      probeCtx.clearRect(0, 0, 1, 1);
      probeCtx.fillStyle = cssColor;
      probeCtx.fillRect(0, 0, 1, 1);
      const [r, g, b] = probeCtx.getImageData(0, 0, 1, 1).data;
      return (
        "#" + [r, g, b].map((n) => n.toString(16).padStart(2, "0")).join("")
      );
    };

    for (const node of document.querySelectorAll<HTMLElement>(
      "[data-color-value]",
    )) {
      const token = node.dataset.colorValue;
      if (token) node.textContent = resolve("--color-", token);
    }
    for (const node of document.querySelectorAll<HTMLElement>(
      "[data-color-hex]",
    )) {
      const token = node.dataset.colorHex;
      if (token) node.textContent = toHex(resolve("--color-", token));
    }
    for (const node of document.querySelectorAll<HTMLElement>(
      "[data-text-value]",
    )) {
      const token = node.dataset.textValue;
      if (!token) continue;
      const raw = resolve("--text-", token);
      const px = toPx(raw);
      node.textContent = px !== null ? `${raw} · ${px}px` : raw;
    }
  </script>
</Layout>
