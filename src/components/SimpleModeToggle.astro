---
/**
 * Simple mode toggle.
 *
 * Hides decorative noise + scanline overlays and swaps the blackletter
 * decorative font for the legible body font (Prompt).
 * State persists in localStorage under "portfolio:simple-mode" as "on" | "off";
 * unset follows prefers-reduced-motion, so reduced-motion users get Effects:
 * Off by default. Applied pre-paint by an is:inline script in Layout.astro to
 * prevent FOUC.
 *
 * The actual visual changes live in src/styles/simple-mode.css.
 */

import IconFx from "./icons/IconFx.svg";
---

<button
  type="button"
  data-simple-mode-toggle
  aria-pressed="false"
  aria-label="Toggle visual effects"
  class="simple-mode-toggle group text-emphasis hover:text-background-dark
    hover:bg-accent-hover focus-visible:bg-accent-hover
    focus-visible:text-background-dark hover:border-accent-hover border-faint
    bg-background-dark aria-pressed:text-fainter
    aria-pressed:hover:bg-accent-hover aria-pressed:hover:text-background-dark
    aria-pressed:focus-visible:bg-accent-hover
    aria-pressed:focus-visible:text-background-dark relative flex h-8 w-8
    shrink-0 items-center justify-center self-center font-mono transition-all
    duration-200 hover:cursor-pointer"
>
  <IconFx class="h-6 w-6" />
  <span class="sr-only">Toggle effects</span>

  <span
    class="simple-mode-toggle__tooltip text-foundation bg-background-dark
      border-faint group-aria-pressed:border-emphasis
      group-aria-pressed:group-hover:border-faint pointer-events-none absolute
      top-full right-0 -z-1 w-49 origin-top scale-y-0 border px-4 py-4 font-mono
      text-sm tracking-wider opacity-0 shadow-lg shadow-black/40 transition
      duration-200 data-[placement=above]:top-auto
      data-[placement=above]:bottom-full data-[placement=above]:mb-0.5
      data-[placement=above]:origin-bottom data-[placement=below]:mt-0.5
      data-[show=true]:scale-y-100 data-[show=true]:opacity-100 sm:right-auto
      sm:-left-px md:w-66"
    data-simple-mode-tooltip
    data-state="off"
    role="tooltip"
    aria-hidden="true"
  >
    <span data-when="off" class="bg-background-dark block text-left">
      <span
        class="text-emphasis relative mb-2 block text-xs uppercase md:text-base"
        >Effects: <span class="text-accent-hover">On</span></span
      >
      <span class="text-2xs relative block w-[28ch] md:text-xs"
        >Click to disable effects & complex fonts</span
      >
    </span>
    <span data-when="on" class="bg-background-dark block text-left">
      <span class="text-emphasis mb-2 block text-xs uppercase md:text-base"
        >Effects: Off</span
      >
      <span class="text-2xs block w-[26ch] md:text-xs"
        >Click to enable effects & complex fonts</span
      >
    </span>
  </span>

  <style>
    .simple-mode-toggle__tooltip[data-state="off"] [data-when="on"],
    .simple-mode-toggle__tooltip[data-state="on"] [data-when="off"] {
      display: none;
    }
  </style>

  <script>
    const STORAGE_KEY = "portfolio:simple-mode";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Same rule as the pre-paint script in Layout.astro.
    function resolve(): boolean {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem(STORAGE_KEY);
      } catch {
        // Storage disabled; fall through to the OS preference.
      }
      return stored === "on" || (stored !== "off" && reducedMotion.matches);
    }

    // Store only deviations from the OS default, so unset keeps following it.
    function writeStored(on: boolean): void {
      try {
        if (on === reducedMotion.matches) {
          localStorage.removeItem(STORAGE_KEY);
        } else {
          localStorage.setItem(STORAGE_KEY, on ? "on" : "off");
        }
      } catch {
        // Safari Private Browsing or storage disabled — silently ignore.
      }
    }

    const button = document.querySelector<HTMLButtonElement>(
      "[data-simple-mode-toggle]",
    );
    const tooltip = document.querySelector<HTMLElement>(
      "[data-simple-mode-tooltip]",
    );

    function applyState(on: boolean): void {
      if (on) {
        document.documentElement.dataset.simpleMode = "on";
      } else {
        delete document.documentElement.dataset.simpleMode;
      }
      button?.setAttribute("aria-pressed", on ? "true" : "false");
      if (tooltip) tooltip.dataset.state = on ? "on" : "off";
    }

    // Initialize from the actual document state (set pre-paint by
    // Layout.astro's inline script). Do NOT re-read localStorage here — the
    // dataset is the source of truth post-paint.
    applyState(document.documentElement.dataset.simpleMode === "on");

    button?.addEventListener("click", () => {
      const next = document.documentElement.dataset.simpleMode !== "on";
      applyState(next);
      writeStored(next);
    });

    // Cross-tab sync: when another tab toggles, mirror the change here.
    window.addEventListener("storage", (event) => {
      if (event.key !== STORAGE_KEY) return;
      applyState(resolve());
    });

    // OS setting changed mid-session: re-resolve (no-op if a choice is stored).
    reducedMotion.addEventListener("change", () => applyState(resolve()));

    // Place above the button while the page is near the top, otherwise below.
    // While near the top there's more empty atmosphere above; once scrolled,
    // the sticky header has empty page space below it.
    function showTooltip(): void {
      if (!tooltip) return;
      tooltip.dataset.placement = window.scrollY < 200 ? "above" : "below";
      tooltip.dataset.show = "true";
    }

    function hideTooltip(): void {
      if (!tooltip) return;
      delete tooltip.dataset.show;
    }

    button?.addEventListener("mouseenter", showTooltip);
    button?.addEventListener("mouseleave", hideTooltip);
    button?.addEventListener("focus", showTooltip);
    button?.addEventListener("blur", hideTooltip);
  </script>
</button>
